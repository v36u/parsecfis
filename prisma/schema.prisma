generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider     = "mysql"
    url          = env("DATABASE_URL")
    relationMode = "prisma"
}

model AppUser {
    id            Int       @id @default(autoincrement())
    publicKey     String    @unique
    email         String?   @unique
    name          String?
    registeredAt  DateTime  @default(now())
    sentFiles     AppFile[] @relation(name: "sender")
    receivedFiles AppFile[] @relation(name: "receiver")
}

model AppFile {
    id         Int      @id @default(autoincrement())
    senderId   Int
    receiverId Int
    s3Key      String   @unique
    isDeleted  Boolean  @default(false)
    sharedAt   DateTime @default(now())
    sender     AppUser  @relation(name: "sender", fields: [senderId], references: [id])
    receiver   AppUser  @relation(name: "receiver", fields: [receiverId], references: [id])

    @@index([senderId])
    @@index([receiverId])
}
