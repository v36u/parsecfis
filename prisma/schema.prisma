generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider     = "mysql"
    url          = env("DATABASE_URL")
    relationMode = "prisma"
}

model AppUser {
    id            Int            @id @default(autoincrement())
    publicKey     String         @unique
    email         String?        @unique
    name          String?
    registeredAt  DateTime       @default(now())
    sentFiles     AppFile[]
    receivedFiles AppFileShare[]
}

model AppFile {
    id        Int            @id @default(autoincrement())
    senderId  Int
    s3Key     String         @unique
    isDeleted Boolean        @default(false)
    sender    AppUser        @relation(fields: [senderId], references: [id])
    shares    AppFileShare[]

    @@index([senderId])
}

model AppFileShare {
    id         Int      @id @default(autoincrement())
    fileId     Int
    receiverId Int
    sharedAt   DateTime @default(now())
    file       AppFile  @relation(fields: [fileId], references: [id])
    receiver   AppUser  @relation(fields: [receiverId], references: [id])

    @@index([fileId])
    @@index([receiverId])
}
